{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "typeRoots": [
      "./node_modules/@types",
      "./testTypes"
    ],
    "types": [
      "bun",
      "node"
    ]
  },
  "include": [
    "./testTypes/**/*.d.ts",
    "setupTests.ts",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.d.ts"
  ]
}
